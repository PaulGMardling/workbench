# Publication allowlist. New files stay local until deliberately reviewed.
/*
!/.gitignore
!/readme.md
!/config/
/config/*
!/config/repositories.example.yaml
!/conventions/
/conventions/*
!/conventions/accessibility-triage.md
!/conventions/change-assessment.md
!/conventions/code-review.md
!/conventions/config-validation.md
!/conventions/create-branch.md
!/conventions/create-worktree.md
!/conventions/css-nesting.md
!/conventions/git-safety.md
!/conventions/task-triage.md
!/conventions/worktree-lifecycle.md
!/workflows/
/workflows/*
!/workflows/start-task.md
!/skills/
/skills/*
!/skills/fluent-a11y-diagnosis/
/skills/fluent-a11y-diagnosis/**
!/skills/fluent-a11y-diagnosis/SKILL.md
!/skills/fluent-a11y-diagnosis/examples/
!/skills/fluent-a11y-diagnosis/examples/report.json
!/skills/fluent-a11y-diagnosis/references/
!/skills/fluent-a11y-diagnosis/references/coordination.md
!/skills/fluent-a11y-diagnosis/references/evidence-contract.md
!/skills/fluent-a11y-diagnosis/references/integration.md
!/skills/fluent-a11y-diagnosis/references/remediation-and-delivery.md
!/skills/fluent-a11y-diagnosis/references/testing.md
!/skills/fluent-a11y-diagnosis/scripts/
!/skills/fluent-a11y-diagnosis/scripts/evaluate.py
!/skills/fluent-a11y-diagnosis/scripts/validate_report.py
**/.DS_Store
**/__pycache__/
*.py[cod]
